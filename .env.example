# Copy to .env (git-ignored) and fill in. The backend loads it however it is started
# (npm scripts, VS Code tasks, `node backend/dist/cli.js`).
# Variables already set in the environment (e.g. Codespaces secrets) take precedence.

# OAuth client (Desktop app) from Google Cloud Console: a file path or the JSON itself.
SORTIFY_CLIENT_SECRETS=/path/to/client_secret.json

# Tag sources (recommended; each is skipped when its keys are missing)
DISCOGS_TOKEN=
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# iTunes store used for genres (default US)
# ITUNES_COUNTRY=IN

# --- The static build (web/) only --------------------------------------------
# Read by Connections -> "Import keys from a .env file" on the GitHub Pages
# build, and ignored by the backend.
#
# This is a second, separate OAuth client, not another way of writing the one
# above. `sortify auth` redirects to a random loopback port, which Google allows
# only for a Desktop app client; a browser redirects to the deployed page, which
# needs a Web application client with that URL registered exactly. Neither
# client works in the other's flow, so both live here side by side.
#
# You can skip these and put the Web client's JSON in SORTIFY_CLIENT_SECRETS
# instead, but only if you do not also use the CLI: the importer takes the pair
# out of it, while `sortify auth` would then fail on the random port.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
