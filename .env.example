# Copy to .env (git-ignored) and fill in. The backend loads it however it is started
# (npm scripts, VS Code tasks, `node backend/dist/cli.js`).
# Variables already set in the environment (e.g. Codespaces secrets) take precedence.

# The OAuth client from Google Cloud Console: a file path, or the JSON itself.
#
# Create it as type **Web application** and register every URL Sortify signs in from.
# Google matches redirect URIs exactly, including the port and the trailing slash:
#
#   Authorized redirect URIs    http://127.0.0.1:4747/   (sortify ui)
#                               http://127.0.0.1:4748/   (sortify auth)
#                               https://<your-pages-url>/
#   Authorized JavaScript origins  https://<your-pages-host>
#
# One client covers the CLI, the local server and the static build. The static build reads this
# same value through Connections -> Import keys from a .env file, which takes the id and secret
# out of the JSON — but a browser cannot open a file path, so store the JSON itself if you want
# the import to pick it up. Pasting GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET works too; the
# backend ignores those two.
SORTIFY_CLIENT_SECRETS={"web":{"client_id":"...","client_secret":"..."}}

# Tag sources (recommended; each is skipped when its keys are missing)
DISCOGS_TOKEN=
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# iTunes store used for genres (default US)
# ITUNES_COUNTRY=IN
